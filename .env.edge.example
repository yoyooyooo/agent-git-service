# AGS Edge: packet-driven local reads can be explicitly enabled below.
# Without a read config, Git reads return 503 read_path_not_wired.
# Optional loopback diagnostics enables live operational readiness checks.
# Enable host-wide routing only after primary/peer and client boundary checks.
# This executable does not auto-load .env or .env.edge.example.
# Load these values explicitly in a process manager or export them before run.

AGS_EDGE_ID=edge-1
# Loopback by default; a later controlled deployment may bind a private IP:6666.
AGS_EDGE_LISTEN_ADDR=127.0.0.1:6667

# Fixed physical primary origin; no credentials, URL path, query or fragment.
AGS_EDGE_PRIMARY_URL=https://primary.internal.example
# Original team AGS identity/Host. Never change primary BASE_URL to the Edge.
AGS_EDGE_CANONICAL_URL=https://ags.example
# Optional comma-separated exact alternative origins of this SAME primary.
# Same scheme and explicit port as canonical; no wildcards or implicit aliases.
# HTTPS termination must also cover every alias in its certificate.
# AGS_EDGE_CANONICAL_ALIASES=https://ags-alias.example

# Cleartext non-loopback primary HTTP is refused unless explicitly permitted
# on a separately secured network. TLS certificate validation stays enabled.
AGS_EDGE_ALLOW_INSECURE_PRIMARY_HTTP=false
AGS_EDGE_REQUEST_TIMEOUT=15m
# Restricted mode rejects unenrolled reads; primary preserves their native behavior.
AGS_EDGE_UNBOUND_READS=reject
# Optional separate operator listener; public and wildcard addresses are refused.
# AGS_EDGE_DIAGNOSTICS_ADDR=127.0.0.1:16667

# No DB_DSN, CONTROL_PLANE_DSN, primary runtime .env, or provider tokens here.
# Explicit opt-in to local Git reads. Copy docs/examples/edge-read.example.json,
# replace identities with actual primary-provisioned grants, provide mTLS files,
# and chmod 600 the config and private key. Paths inside JSON are relative to it.
# The primary peer listener must be attached to the original primary process.
# This does not provision identities, start a primary, change remotes or enable
# production readiness. Incremental transfer and published-view budgets exist;
# primary source/snapshots must share a hardlink-capable filesystem. Total
# filesystem headroom, maintenance topology and live rollout are still gated.
# AGS_EDGE_READ_CONFIG_FILE=/absolute/path/to/edge-read.json
